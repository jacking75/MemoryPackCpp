<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>cs2cpp</AssemblyName>
    <RootNamespace>Cs2Cpp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn: the C# parser that replaced the old regex-based reader. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.*" ExcludeAssets="analyzers" />
  </ItemGroup>

</Project>
